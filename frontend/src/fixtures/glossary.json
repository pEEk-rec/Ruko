{"kind":"glossary","found":true,"term":"ipo","title":"IPO (initial public offering)","body":"An IPO is when a company sells its shares to the public for the first time. People apply during a fixed window; shares are allotted after it closes and then start trading on a stock exchange. Applying does not mean you will get shares. This is a general explanation, not a view on any product.","sources":[{"source_title":"SEBI Investor Website","source_url":"https://investor.sebi.gov.in","as_of":"2026-10-03","verified_by_human":false}],"speak":[{"key":"glossary.ipo.title","slots":{}},{"key":"glossary.ipo.body","slots":{}},{"key":"glossary.note","slots":{}}],"meta":{"request_id":"31c8b2b6c64c4d85ad450070d0ac3751","locale":"en","policy_version":null,"prompt_version":null,"extraction_mode":"not_run","stage":"learn","stage_source":"lexicon","unverified_fact_ids":["regulatory:sebi_investor_website"],"draft_template_count":3,"missing_template_keys":[],"blocked_output_count":0,"trace":[{"step":"detect_language","status":"ok","duration_ms":0.03,"reason_codes":[]},{"step":"intent_gate","status":"ok","duration_ms":0.14,"reason_codes":[]},{"step":"redact","status":"ok","duration_ms":0.02,"reason_codes":[]},{"step":"deterministic_signals","status":"ok","duration_ms":0.16,"reason_codes":[]},{"step":"stage","status":"ok","duration_ms":0.04,"reason_codes":[]},{"step":"glossary","status":"ok","duration_ms":5.07,"reason_codes":[]}]}}