{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": false,
    "pr": false,
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(ruff *)",
      "Bash(python -m ruff *)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(python *)",
      "Bash(uvicorn *)",
      "Bash(docker build *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "WebSearch",
      "WebFetch"
    ],
    "ask": [
      "Bash(git *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force *)"
    ]
  }
}
