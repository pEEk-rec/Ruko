# Copy to .env for local development. Never commit the real .env.
# All settings are optional; defaults are in src/ruko/config.py.

RUKO_ENVIRONMENT=dev
RUKO_LOG_LEVEL=INFO
RUKO_DEFAULT_LOCALE=en
# Facts not yet verified by a human: shown in dev/test, hidden in prod unless set here.
# RUKO_SHOW_UNVERIFIED_FACTS=false
RUKO_ENABLED_LOCALES=en,hi,kn

# LLM: auto | gemini | fake | none   (auto = gemini if a key is set, else lexicon-only)
RUKO_LLM_PROVIDER=auto
RUKO_GEMINI_API_KEY=replace-with-your-key
RUKO_GEMINI_MODEL=gemini-3.8-flash
RUKO_LLM_TIMEOUT_SECONDS=15
RUKO_LLM_MAX_RETRIES=2
RUKO_LLM_INVALID_OUTPUT_RETRIES=1

# Speech: comma-separated fallback order (sarvam | fake); missing keys are skipped
RUKO_SPEECH_PROVIDERS=sarvam
RUKO_SARVAM_API_KEY=replace-with-your-key

# HTTP edge
RUKO_CORS_ALLOW_ORIGINS=
RUKO_RATE_LIMIT_PER_MINUTE=60
